# --- Database ---
# Postgres connection string. For local dev, point this at any local Postgres.
# For a free hosted deploy, get one from Neon (neon.tech) or provision one
# directly from Vercel's Storage tab (Postgres, powered by Neon).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# Random long string used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# --- Embedded wallet custody ---
# 32-byte (64 hex char) key used to encrypt custodial Stellar secret keys at rest.
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY="replace-with-64-hex-characters"

# --- Stellar network ---
# live: real Stellar testnet via Horizon + Friendbot (default — use this).
# mock: a DB-backed simulated ledger with no network calls, for developing or
#       demoing behind a firewall that blocks *.stellar.org. See lib/stellar.ts.
STELLAR_MODE="live"
# testnet | futurenet | mainnet (mainnet not wired up in this MVP — see ROADMAP.md)
STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_FRIENDBOT_URL="https://friendbot.stellar.org"

# Demo/display only: used to show an estimated NGN price next to on-chain XLM
# amounts. Not a real FX oracle — see ROADMAP.md for the production anchor plan.
DEMO_XLM_TO_NGN_RATE="165"
